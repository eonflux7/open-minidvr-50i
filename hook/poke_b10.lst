      00DA4D A3               [24]   56         inc     dptr
      00DA4E E0               [24]   57         movx    a,@dptr
      00DA4F C0 E0            [24]   58         push    0xE0
      00DA51 90 70 08         [24]   59         mov     dptr,#0x7008        ; page 0x00FF -> big-memory 0x7F8000 at XDATA 0x8000
      00DA54 74 FF            [12]   60         mov     a,#0xFF
      00DA56 F0               [24]   61         movx    @dptr,a
      00DA57 A3               [24]   62         inc     dptr
      00DA58 E4               [12]   63         clr     a
      00DA59 F0               [24]   64         movx    @dptr,a
      00DA5A 7A FE            [12]   65         mov     r2,#0xFE            ; src 0xFE00
      00DA5C 7B 00            [12]   66         mov     r3,#0x00
      00DA5E 7C 6A            [12]   67         mov     r4,#0x6A            ; dst 0x6A00
      00DA60 7D 00            [12]   68         mov     r5,#0x00
      00DA62 7E 02            [12]   69         mov     r6,#2               ; 2 x 256 bytes
      00DA64 7F 00            [12]   70         mov     r7,#0
      00DA66 8A 83            [24]   71 cpy:    mov     0x83,r2
      00DA68 8B 82            [24]   72         mov     0x82,r3
      00DA6A E0               [24]   73         movx    a,@dptr
      00DA6B A3               [24]   74         inc     dptr
      00DA6C AA 83            [24]   75         mov     r2,0x83
      00DA6E AB 82            [24]   76         mov     r3,0x82
      00DA70 8C 83            [24]   77         mov     0x83,r4
      00DA72 8D 82            [24]   78         mov     0x82,r5
      00DA74 F0               [24]   79         movx    @dptr,a
      00DA75 A3               [24]   80         inc     dptr
      00DA76 AC 83            [24]   81         mov     r4,0x83
      00DA78 AD 82            [24]   82         mov     r5,0x82
      00DA7A DF EA            [24]   83         djnz    r7,cpy
      00DA7C DE E8            [24]   84         djnz    r6,cpy
      00DA7E 90 70 09         [24]   85         mov     dptr,#0x7009        ; restore window page
      00DA81 D0 E0            [24]   86         pop     0xE0
      00DA83 F0               [24]   87         movx    @dptr,a
      00DA84 90 70 08         [24]   88         mov     dptr,#0x7008
      00DA87 D0 E0            [24]   89         pop     0xE0
      00DA89 F0               [24]   90         movx    @dptr,a
      00DA8A D0 A8            [24]   91         pop     0xA8
      00DA8C 7F 01            [12]   92         mov     r7,#0x01            ; apply "boot" entries
      00DA8E 12 DA 94         [24]   93         lcall   apply
      00DA91 02 A5 17         [24]   94 bdone:  ljmp    0xA517              ; the call we replaced
                                     95 
                                     96 ; apply(R7 = flag mask): walk entries at 0x6A04..0x6BBF
      00DA94 90 6A 00         [24]   97 apply:  mov     dptr,#0x6A00
      00DA97 E0               [24]   98         movx    a,@dptr
      00DA98 B4 50 5B         [24]   99         cjne    a,#0x50,aret        ; 'P'
      00DA9B A3               [24]  100         inc     dptr
      00DA9C E0               [24]  101         movx    a,@dptr
      00DA9D B4 4B 56         [24]  102         cjne    a,#0x4B,aret        ; 'K'
      00DAA0 A3               [24]  103         inc     dptr
      00DAA1 E0               [24]  104         movx    a,@dptr
      00DAA2 B4 30 51         [24]  105         cjne    a,#0x30,aret        ; '0'
      00DAA5 A3               [24]  106         inc     dptr
      00DAA6 E0               [24]  107         movx    a,@dptr
      00DAA7 B4 31 4C         [24]  108         cjne    a,#0x31,aret        ; '1'
      00DAAA 7A 6A            [12]  109         mov     r2,#0x6A
      00DAAC 7B 04            [12]  110         mov     r3,#0x04
