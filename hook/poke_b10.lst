      00DAAE EA               [12]  111 aloop:  mov     a,r2                ; stop at 0x6BC0
      00DAAF 64 6B            [12]  112         xrl     a,#0x6B
      00DAB1 70 06            [24]  113         jnz     aok
      00DAB3 EB               [12]  114         mov     a,r3
      00DAB4 C3               [12]  115         clr     c
      00DAB5 94 C0            [12]  116         subb    a,#0xC0
