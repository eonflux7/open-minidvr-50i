                                      1 ; SD-card poke hook, boot part. Lives in bank10 free space (zero padding from D9F5).
                                      2 ; Entered from bank10:8A7D (was LCALL A517, right after the firmware's own UPDATE.TXT check).
                                      3 ;
                                      4 ; If the card is ready and UPOKE.BIN exists, the firmware's loader (CODE:0E3E, bank04:8000) copies it to
                                      5 ; big-memory 0x7FFE00 (names starting with 'U' go there; <= 512 bytes). We copy those 512 bytes through the
                                      6 ; XDATA window (page 0xFF at 0xFE00) to XDATA 0x6A00 and apply entries flagged "boot".
                                      7 ;
                                      8 ; UPOKE.BIN: "PK01", then 4-byte entries [flags][addr hi][addr lo][value], flags 0 = end.
                                      9 ;   flags bit0 = apply at boot, bit1 = apply at record start, high nibble = op: 0 write, 1 OR, 2 AND.
                                     10 ; Entries are read from 0x6A04 up to 0x6BBF (6BC0-6BCF: logger state snapshot, 6BE0-6BE8: logger state).
                                     11 
                                     12         .area   CODE (ABS)
      00DA00                         13         .org    0xDA00
                                     14 
      00DA00 90 6B E0         [24]   15 boot:   mov     dptr,#0x6BE0        ; logger disarmed; state, counters and experiment switches 6BE0-6BEF cleared
      00DA03 7F 10            [12]   16         mov     r7,#16
      00DA05 E4               [12]   17         clr     a
      00DA06 F0               [24]   18 bclr:   movx    @dptr,a
      00DA07 A3               [24]   19         inc     dptr
      00DA08 DF FC            [24]   20         djnz    r7,bclr
      00DA0A 90 6B FB         [24]   21         mov     dptr,#0x6BFB        ; edge fix switch, AC40-path wait (peek_b07.asm) off
      00DA0D F0               [24]   22         movx    @dptr,a
      00DA0E A3               [24]   23         inc     dptr
      00DA0F F0               [24]   24         movx    @dptr,a
      00DA10 12 0C EE         [24]   25         lcall   0x0CEE              ; card ready? (bank04:A543) -> R7
      00DA13 EF               [12]   26         mov     a,r7
      00DA14 60 7B            [24]   27         jz      bdone
      00DA16 90 6B FF         [24]   28         mov     dptr,#0x6BFF        ; RAM self-test of the buffer area
      00DA19 74 5A            [12]   29         mov     a,#0x5A
      00DA1B F0               [24]   30         movx    @dptr,a
      00DA1C E0               [24]   31         movx    a,@dptr
      00DA1D B4 5A 71         [24]   32         cjne    a,#0x5A,bdone
      00DA20 74 A5            [12]   33         mov     a,#0xA5
      00DA22 F0               [24]   34         movx    @dptr,a
      00DA23 E0               [24]   35         movx    a,@dptr
      00DA24 B4 A5 6A         [24]   36         cjne    a,#0xA5,bdone
      00DA27 90 6A 00         [24]   37         mov     dptr,#0x6A00        ; invalidate any stale buffer
      00DA2A E4               [12]   38         clr     a
      00DA2B F0               [24]   39         movx    @dptr,a
      00DA2C 78 F0            [12]   40         mov     r0,#0xF0            ; copy 11-char 8.3 name to XDATA 0x6BF0 (bank10:BA7A, src in CODE)
      00DA2E 7C 6B            [12]   41         mov     r4,#0x6B
      00DA30 7A DA            [12]   42         mov     r2,#>name
      00DA32 79 F7            [12]   43         mov     r1,#<name
      00DA34 12 BA 7A         [24]   44         lcall   0xBA7A
      00DA37 7B 01            [12]   45         mov     r3,#0x01            ; generic ptr 01:6BF0 -> look up + load file
      00DA39 7A 6B            [12]   46         mov     r2,#0x6B
      00DA3B 79 F0            [12]   47         mov     r1,#0xF0
      00DA3D 12 0E 3E         [24]   48         lcall   0x0E3E
      00DA40 EF               [12]   49         mov     a,r7
      00DA41 60 4E            [24]   50         jz      bdone
      00DA43 C0 A8            [24]   51         push    0xA8                ; IE
      00DA45 C2 AF            [12]   52         clr     0xAF                ; EA off while we own the window
      00DA47 90 70 08         [24]   53         mov     dptr,#0x7008        ; save window read page (we only read; 700A/0B is the write page)
      00DA4A E0               [24]   54         movx    a,@dptr
      00DA4B C0 E0            [24]   55         push    0xE0
