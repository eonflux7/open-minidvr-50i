                                      1 ; SD-card poke hook, record-start part. Lives in bank13 free space (zero padding from E742).
                                      2 ; Entered from bank13:C203 (was MOV R7,#1 / RET at the end of the per-recording start routine, after the AVI header
                                      3 ; has been built in big memory 0x7D0000 by bank11:8000).
                                      4 ; Applies UPOKE.BIN entries flagged "record start" (bit1) from the XDATA 0x6A00 buffer filled at boot, then arms the
                                      5 ; per-field read-back logger (peek_b07.asm) if the file has "peek" entries (flags & F4 == 34).
                                      6 ;
                                      7 ; Log layout in the AVI header JUNK chunk (file offset 0x14A, body 0x152..0x7FF3; window XDATA 0x8000 = file offset 0):
                                      8 ;   0x160: "PLG2", record length, number of peek entries, 16 bytes = logger state 6BE0-6BEF left by the previous
                                      9 ;          recording (armed flag, ptr, reclen, seq, event counters), then a copy of each peek entry (flags, hi, lo, count)
                                     10 ;   then records (see peek_b07.asm) until the chunk is full (stop at XDATA 0xFFF0).
                                     11 
                                     12         .area   CODE (ABS)
      00E800                         13         .org    0xE800
                                     14 
      00E800 7F 02            [12]   15 rec:    mov     r7,#0x02
      00E802 12 E8 24         [24]   16         lcall   apply
      00E805 12 E8 80         [24]   17         lcall   loginit
      00E808 7F 01            [12]   18         mov     r7,#0x01            ; the instructions we replaced
      00E80A 22               [24]   19         ret
                                     20 
                                     21 ; magic: A = 0 if the buffer holds "PK01"
      00E80B 90 6A 00         [24]   22 magic:  mov     dptr,#0x6A00
      00E80E E0               [24]   23         movx    a,@dptr
      00E80F 64 50            [12]   24         xrl     a,#0x50             ; 'P'
      00E811 70 10            [24]   25         jnz     mret
      00E813 A3               [24]   26         inc     dptr
      00E814 E0               [24]   27         movx    a,@dptr
      00E815 64 4B            [12]   28         xrl     a,#0x4B             ; 'K'
      00E817 70 0A            [24]   29         jnz     mret
      00E819 A3               [24]   30         inc     dptr
      00E81A E0               [24]   31         movx    a,@dptr
      00E81B 64 30            [12]   32         xrl     a,#0x30             ; '0'
      00E81D 70 04            [24]   33         jnz     mret
      00E81F A3               [24]   34         inc     dptr
      00E820 E0               [24]   35         movx    a,@dptr
      00E821 64 31            [12]   36         xrl     a,#0x31             ; '1'
      00E823 22               [24]   37 mret:   ret
                                     38 
                                     39 ; apply(R7 = flag mask): walk entries at 0x6A04..0x6BBF; ops 0 write, 1 OR, 2 AND, 5 XOR (3 peek / 4 hdr skipped)
      00E824 12 E8 0B         [24]   40 apply:  lcall   magic
      00E827 70 55            [24]   41         jnz     aret
      00E829 7A 6A            [12]   42         mov     r2,#0x6A
      00E82B 7B 04            [12]   43         mov     r3,#0x04
      00E82D EA               [12]   44 aloop:  mov     a,r2                ; stop at 0x6BC0
      00E82E 64 6B            [12]   45         xrl     a,#0x6B
      00E830 70 06            [24]   46         jnz     aok
      00E832 EB               [12]   47         mov     a,r3
      00E833 C3               [12]   48         clr     c
      00E834 94 C0            [12]   49         subb    a,#0xC0
      00E836 50 46            [24]   50         jnc     aret
      00E838 8A 83            [24]   51 aok:    mov     0x83,r2
